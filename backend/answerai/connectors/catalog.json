              {
                "name": "q",
                "in": "query",
                "required": false,
                "description": "q",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "singleEvents",
                "in": "query",
                "required": false,
                "description": "singleEvents",
                "schema": {
                  "type": "boolean"
                }
              },
              {
                "name": "maxResults",
                "in": "query",
                "required": false,
                "description": "maxResults",
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              {
                "name": "pageToken",
                "in": "query",
                "required": false,
                "description": "pageToken",
                "schema": {
                  "type": "string"
                }
              }
            ],
            "responses": {
              "200": {
                "description": "Provider response",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
